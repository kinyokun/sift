{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sift",
  "version": "0.3.3",
  "identifier": "app.sift.culler",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sift",
        "width": 1320,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' sift: http://sift.localhost data: blob:; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost sift: http://sift.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright 2026 kinyokun and the Sift contributors",
    "homepage": "https://github.com/kinyokun/sift",
    "shortDescription": "Fast photo culling for JPEG and RAW",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
