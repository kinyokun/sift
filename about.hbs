<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Sift – third-party licences</title>
<style>
  body { font: 14px/1.5 system-ui, sans-serif; max-width: 860px; margin: 2em auto; padding: 0 16px; color: #222; background: #fff; }
  pre { white-space: pre-wrap; background: #f5f5f5; padding: 12px; border-radius: 6px; font-size: 12px; }
  h2 { margin-top: 2em; }
  li { margin: 2px 0; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>Sift is licensed under GPL-3.0-or-later. It contains the Rust crates below; bundled models, fonts and npm packages are listed in NOTICE and THIRD_PARTY_NOTICES.md in the source repository.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
